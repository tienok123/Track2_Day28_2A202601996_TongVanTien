# Local port overrides to avoid conflicts with other containers on this host.
LAB28_MLFLOW_PORT=5100
LAB28_GATEWAY_PORT=8088
LAB28_API_PORT=8100
LAB28_AIRFLOW_PORT=8182
LAB28_GRAFANA_PORT=3100
LAB28_PROMETHEUS_PORT=9190
LAB28_VLLM_PORT=8101
LAB28_VLLM_MODEL_ID=Qwen/Qwen3-1.7B
# vLLM is optional on CPU-only hosts; the GPU compose file sets this to "true"
# and forces the gate to verify a real vLLM build before accepting traffic.
LAB28_VLLM_REQUIRE_REAL=false
MLFLOW_TRACKING_URI=http://localhost:5100
LAB28_FEAST_SERVER_URL=http://localhost:6566
